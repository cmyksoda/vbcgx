set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR powerpc)
set(CMAKE_C_COMPILER $ENV{DEVKITPPC}/bin/powerpc-eabi-gcc)
set(CMAKE_CXX_COMPILER $ENV{DEVKITPPC}/bin/powerpc-eabi-g++)
set(CMAKE_AR $ENV{DEVKITPPC}/bin/powerpc-eabi-ar)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
# (Espresso runs Broadway's code: GEKKO keeps the recompiler and paired singles, __WIIU__ marks what Cafe OS does differently)
set(CMAKE_C_FLAGS_INIT "-mcpu=750 -meabi -mhard-float -DESPRESSO -DGEKKO -D__WIIU__ -DMSB_FIRST -ffunction-sections -fdata-sections")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} -fno-exceptions -fno-rtti")
