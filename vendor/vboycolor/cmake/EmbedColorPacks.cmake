# The color packs, built into the RetroArch core (platform/libretro): run as
# a script (cmake -P) in an empty staging folder -
#
#   cmake -DPACK_DIR=<repo>/colorpacks -DOUT=<file>.c -P EmbedColorPacks.cmake
#
# - copies the packs here and writes index.txt beside them: the ROM each was
#   made for (its "VBGOROM1" footer: CRC-32 and size), as the Android build
#   does (android/app/build.gradle), plus colorpacks/aliases.txt's lines;
# - zips them (deflate - 30 MB of packs is about 4 MB zipped);
# - writes the zip into OUT as a C array, vbc_packs_zip / vbc_packs_zip_size.
cmake_minimum_required(VERSION 3.18)

file(GLOB packs "${PACK_DIR}/*.vbcp")
list(SORT packs)
set(index "")
set(names "")
foreach(pack IN LISTS packs)
    get_filename_component(name "${pack}" NAME)
    file(COPY "${pack}" DESTINATION ".")
    list(APPEND names "${name}")
    file(SIZE "${pack}" size)
    if(size GREATER_EQUAL 28)
        math(EXPR at "${size} - 16")
        file(READ "${pack}" footer OFFSET ${at} LIMIT 16 HEX)
        string(SUBSTRING "${footer}" 0 16 magic)
        if(magic STREQUAL "5642474f524f4d31") # "VBGOROM1"
            # (little-endian CRC-32 and size after the magic)
            string(SUBSTRING "${footer}" 16 8 c)
            string(SUBSTRING "${footer}" 24 8 s)
            string(REGEX REPLACE "(..)(..)(..)(..)" "\\4\\3\\2\\1" crc "${c}")
            string(REGEX REPLACE "(..)(..)(..)(..)" "\\4\\3\\2\\1" romSizeHex "${s}")
            math(EXPR romSize "0x${romSizeHex}")
            string(APPEND index "${crc} ${romSize} ${name}\n")
        endif()
    endif()
endforeach()
if(EXISTS "${PACK_DIR}/aliases.txt")
    file(STRINGS "${PACK_DIR}/aliases.txt" aliases)
    foreach(line IN LISTS aliases)
        string(STRIP "${line}" line)
        if(line)
            string(APPEND index "${line}\n")
        endif()
    endforeach()
endif()
file(WRITE "index.txt" "${index}")
list(APPEND names "index.txt")

file(REMOVE "packs.zip")
file(ARCHIVE_CREATE OUTPUT "packs.zip" PATHS ${names} FORMAT zip)

file(READ "packs.zip" hex HEX)
string(LENGTH "${hex}" hexLength)
math(EXPR bytes "${hexLength} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," body "${hex}")
# (a line break now and then keeps compilers' line lengths sane)
string(REGEX REPLACE "((0x..,){32})" "\\1\n" body "${body}")
file(WRITE "${OUT}" "/* Generated by cmake/EmbedColorPacks.cmake - the color packs, zipped. */
#include <stddef.h>
const unsigned char vbc_packs_zip[] = {
${body}
};
const size_t vbc_packs_zip_size = ${bytes};
")
list(LENGTH packs count)
message(STATUS "Color packs built in: ${count} (${bytes} bytes zipped)")
